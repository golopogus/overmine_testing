;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="overmineGame"
run/main_scene="uid://15d6kjfxhuns"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

MapManager="*res://map_manager.gd"
MapCalculator="*res://map_calculator.gd"
GameManager="*res://game_manager.gd"

[debug]

settings/gdscript/always_track_call_stacks=true
settings/gdscript/always_track_local_variables=true

[display]

